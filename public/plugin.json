{
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginSetting": {
    "single": true,
    "height": 400
  },
  "features": [
    {
      "code": "toolbox",
      "explain": "打开 tutu 工具箱",
      "cmds": ["tutu"]
    },
    {
      "code": "hash",
      "explain": "进入哈希计算",
      "cmds": [
        "hash",
        {
          "type": "over",
          "label": "哈希计算",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    },
    {
      "code": "sh",
      "explain": "执行 Shell 命令",
      "cmds": [
        "sh",
        {
          "type": "regex",
          "label": "执行 Shell 命令",
          "match": "/^sh\\s+\\S.*$/"
        }
      ]
    }
  ]
}